<Window x:Class="EquipmentSimulator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentSimulator.Desktop"
        mc:Ignorable="d"
        Title="FabOps Control Center — Equipment Simulator &amp; Process Physics Engine"
        Height="840"
        Width="1140"
        MinHeight="700"
        MinWidth="960"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0B1120"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextLight" Color="#F1F5F9"/>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
        </Style>

        <!-- Warning Button -->
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B45309"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>

        <!-- Success Button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#047857"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
        </Style>

        <!-- Speed Selector Pill Button -->
        <Style x:Key="SpeedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>

        <!-- Custom Smooth ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0284C7" Offset="0"/>
                                            <GradientStop Color="#38BDF8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- 4 Telemetry HUD Cards -->
            <RowDefinition Height="Auto"/> <!-- Process Step Sequence Pipeline -->
            <RowDefinition Height="Auto"/> <!-- Recipe & Run Control Bar -->
            <RowDefinition Height="Auto"/> <!-- Fault Injection Bar -->
            <RowDefinition Height="*"/>    <!-- Event Audit Log -->
            <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER & CONNECTION BAR -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔬 FabOps Control Center" FontSize="19" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#1E293B" CornerRadius="4" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="Equipment Simulator &amp; Brain" FontSize="11" Foreground="#94A3B8" FontWeight="Medium"/>
                        </Border>
                        <Border Background="#0C4A6E" CornerRadius="4" Margin="6,0,0,0" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="SEMI E30 (GEM)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Autonomous semiconductor process sequencer, high-vacuum physics simulation, and real-time fault interlock engine."
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Speed Multiplier + Connection Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Speed Selector -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Sim Speed:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                            <Button Content="1x" Command="{Binding SetSpeedCommand}" CommandParameter="1.0" Style="{StaticResource SpeedButton}"/>
                            <Button Content="2x" Command="{Binding SetSpeedCommand}" CommandParameter="2.0" Style="{StaticResource SpeedButton}"/>
                            <Button Content="5x" Command="{Binding SetSpeedCommand}" CommandParameter="5.0" Style="{StaticResource SpeedButton}"/>
                            <Button Content="10x" Command="{Binding SetSpeedCommand}" CommandParameter="10.0" Style="{StaticResource SpeedButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Host Connection Status Pill -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerRed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                                <Setter Property="Fill" Value="{StaticResource SuccessGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Host: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextLight}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,3,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TELEMETRY & STATUS CARDS (4 HUD PANELS) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Equipment State & ID -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="OPERATIONAL STATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4" VerticalAlignment="Center">
                        <Border CornerRadius="6" Padding="10,3" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#475569"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="OFFLINE">
                                            <Setter Property="Background" Value="#334155"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="IDLE">
                                            <Setter Property="Background" Value="#0284C7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="SETUP">
                                            <Setter Property="Background" Value="#6366F1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="EXECUTING">
                                            <Setter Property="Background" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="PAUSED">
                                            <Setter Property="Background" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="ALARM">
                                            <Setter Property="Background" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="MAINTENANCE">
                                            <Setter Property="Background" Value="#7C3AED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EquipmentState}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding EquipmentId, StringFormat='ID: {0}'}" FontSize="11" Foreground="{StaticResource TextLight}"/>
                    <TextBlock Text="{Binding ModelType, StringFormat='Model: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Vacuum Physics Telemetry -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CHAMBER VACUUM PRESSURE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding VacuumPressureFormatted}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2"/>
                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,0,0">
                        <TextBlock Text="{Binding VacuumPhase}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: Thermal & Optical Laser Dose -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="THERMAL &amp; OPTICAL METRICS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Temperature:" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding ChamberTemperatureFormatted}" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Laser Flux:" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding LaserDoseFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding LastAlarmMessage}" FontSize="10" Foreground="#F87171" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Wafer & Overall Lot Progress -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="LOT &amp; WAFER PROGRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding WaferStatusFormatted}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="Current Step Progress:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,2"/>
                    <Grid>
                        <ProgressBar Value="{Binding StepProgressPercent, Mode=OneWay}" Maximum="100"/>
                        <TextBlock Text="{Binding StepProgressPercent, StringFormat='{}{0:F1}%'}" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Overall Lot Progress:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,2"/>
                    <Grid>
                        <ProgressBar Value="{Binding LotProgressPercent, Mode=OneWay}" Maximum="100"/>
                        <TextBlock Text="{Binding LotProgressPercent, StringFormat='{}{0:F1}%'}" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. VISUAL PROCESS STEP SEQUENCE PIPELINE -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="PROCESS STEP SEQUENCE PIPELINE (PHYSICAL TOOL STATE)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Active Step: " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding CurrentStepName}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Wafer Load -->
                    <Border Grid.Column="0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0B1120"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                                        <Setter Property="Background" Value="#0369A1"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦 Step 1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Wafer Load &amp; Align" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Atmospheric (760 Torr)" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Pump Down -->
                    <Border Grid.Column="1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0B1120"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                                        <Setter Property="Background" Value="#0369A1"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🌪️ Step 2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chamber Evacuation" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Turbo Pump → 1.0e-6 Torr" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Exposure -->
                    <Border Grid.Column="2" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0B1120"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                                        <Setter Property="Background" Value="#047857"/>
                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚡ Step 3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Laser Exposure Scan" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" HorizontalAlignment="Center"/>
                            <TextBlock Text="ArF / EUV Dose Scan" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 4: Chamber Vent -->
                    <Border Grid.Column="3" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0B1120"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                                        <Setter Property="Background" Value="#0369A1"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💨 Step 4" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chamber N2 Vent" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Purge → 760 Torr" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 5: Wafer Unload -->
                    <Border Grid.Column="4" BorderThickness="1" CornerRadius="6" Padding="8,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0B1120"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep5Active}" Value="True">
                                        <Setter Property="Background" Value="#0369A1"/>
                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📤 Step 5" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Wafer Unload" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" HorizontalAlignment="Center"/>
                            <TextBlock Text="FOUP Advance &amp; Index" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. RECIPE CONFIGURATION & RUN CONTROLS -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Inputs row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recipe Preset Dropdown -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Recipe Program Preset:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableRecipes}"
                                  SelectedItem="{Binding SelectedRecipe}"
                                  DisplayMemberPath="RecipeName"
                                  Background="#0B1120"
                                  Foreground="#F8FAFC"
                                  BorderBrush="#475569"
                                  Padding="6,4"/>
                    </StackPanel>

                    <!-- Lot ID -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Target Lot ID:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding LotInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Total Wafers -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Wafers / Lot:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding TotalWafersInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons WrapPanel -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="⚡ Power On (Idle)" Command="{Binding PowerOnCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="📋 Setup Run" Command="{Binding SetupCommand}"/>
                    <Button Content="▶ Start Process Run" Command="{Binding StartRunCommand}" Style="{StaticResource SuccessButton}"/>
                    <Button Content="⏸ Pause" Command="{Binding PauseCommand}" Style="{StaticResource WarningButton}"/>
                    <Button Content="⏯ Resume" Command="{Binding ResumeCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="⏹ Stop / Abort" Command="{Binding StopCommand}"/>
                    <Button Content="🔄 Clear Alarm" Command="{Binding ClearAlarmCommand}" Style="{StaticResource WarningButton}"/>
                    <Button Content="🛠 Maintenance" Command="{Binding MaintenanceCommand}"/>
                    <Button Content="🛑 Power Off" Command="{Binding PowerOffCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 5. FAULT & ANOMALY INJECTION BAR -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="🚨 FAULT INJECTION (SAFETY TRIPS)" FontSize="10" FontWeight="Bold" Foreground="#F87171"/>
                    <TextBlock Text="Simulate hardware anomalies" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💥 Chamber Vacuum Leak (ALARM-301)" Command="{Binding InjectVacuumLeakCommand}" Style="{StaticResource DangerButton}"/>
                    <Button Content="🔥 Thermal Runaway (ALARM-402)" Command="{Binding InjectThermalExcursionCommand}" Style="{StaticResource DangerButton}"/>
                    <Button Content="🔍 Optics Degradation (ALARM-505)" Command="{Binding InjectLaserFaultCommand}" Style="{StaticResource WarningButton}"/>
                    <Button Content="🤖 Robot End-Effector Error (ALARM-104)" Command="{Binding InjectWaferTransferErrorCommand}" Style="{StaticResource WarningButton}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 6. AUDIT LOG / REAL-TIME EVENT STREAM -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="REAL-TIME TELEMETRY, STATE TRANSITIONS &amp; EVENT AUDIT STREAM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Live chronological domain events" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding AuditLogs}"
                         Background="#0B1120"
                         BorderBrush="#334155"
                         BorderThickness="1"
                         Foreground="#E2E8F0"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#1E293B"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 7. STATUS BAR FOOTER -->
        <Border Grid.Row="6" Background="#0B1120" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource PrimaryAccent}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Milestone 4 — Process Engine &amp; Physics Simulation | .NET Framework 4.8.1" FontSize="10" Foreground="{StaticResource TextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>