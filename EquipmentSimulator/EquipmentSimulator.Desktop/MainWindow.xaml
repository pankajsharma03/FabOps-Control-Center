<Window x:Class="EquipmentSimulator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentSimulator.Desktop"
        mc:Ignorable="d"
        Title="FabOps Control Center — Equipment Simulator"
        Height="720"
        Width="960"
        MinHeight="600"
        MinWidth="800"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0B1120"/>
        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextLight" Color="#F1F5F9"/>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
        </Style>

        <!-- Warning Button -->
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B45309"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>

        <!-- Success Button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#047857"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status & Telemetry Cards -->
            <RowDefinition Height="Auto"/> <!-- Controls Panel -->
            <RowDefinition Height="*"/>    <!-- Event Audit Log -->
            <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔬 FabOps Control Center" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#1E293B" CornerRadius="4" Margin="12,0,0,0" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="Equipment Simulator" FontSize="12" Foreground="#94A3B8" FontWeight="Medium"/>
                        </Border>
                        <Border Background="#0C4A6E" CornerRadius="4" Margin="6,0,0,0" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="SEMI E30 Aligned" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Semiconductor manufacturing equipment domain simulator with state matrix validation."
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Host Connection Status Pill & Connect/Disconnect -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DangerRed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                                <Setter Property="Fill" Value="{StaticResource SuccessGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Host: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextLight}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,4,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TELEMETRY & STATUS CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Equipment State & ID -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="EQUIPMENT OPERATIONAL STATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4" VerticalAlignment="Center">
                        <Border CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#475569"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="OFFLINE">
                                            <Setter Property="Background" Value="#334155"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="IDLE">
                                            <Setter Property="Background" Value="#0284C7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="SETUP">
                                            <Setter Property="Background" Value="#6366F1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="EXECUTING">
                                            <Setter Property="Background" Value="#059669"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="PAUSED">
                                            <Setter Property="Background" Value="#D97706"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="ALARM">
                                            <Setter Property="Background" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EquipmentState}" Value="MAINTENANCE">
                                            <Setter Property="Background" Value="#7C3AED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EquipmentState}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding EquipmentId, StringFormat='ID: {0}'}" FontSize="12" Foreground="{StaticResource TextLight}"/>
                    <TextBlock Text="{Binding ModelType, StringFormat='Model: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Production Context -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ACTIVE PRODUCTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Recipe:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding ActiveRecipeId}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Lot Number:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ActiveLotId}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextLight}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Alarm & Fault Diagnostic -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ALARM / DIAGNOSTIC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Last Alarm Message:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding LastAlarmMessage}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextLight}" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Equipment Info & Timestamps -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Serial Number:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SerialNumber}" FontSize="12" Foreground="{StaticResource TextLight}"/>
                    <TextBlock Text="Last State Change:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding LastStateChangeTime}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- COMMAND & CONTROL PANEL -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Inputs row -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Recipe Name:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding RecipeInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Target Lot ID:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LotInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- State Transition Action Buttons -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="⚡ Power On (Idle)" Command="{Binding PowerOnCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="📋 Setup Run" Command="{Binding SetupCommand}"/>
                    <Button Content="▶ Start Run" Command="{Binding StartRunCommand}" Style="{StaticResource SuccessButton}"/>
                    <Button Content="⏸ Pause" Command="{Binding PauseCommand}" Style="{StaticResource WarningButton}"/>
                    <Button Content="⏯ Resume" Command="{Binding ResumeCommand}" Style="{StaticResource SuccessButton}"/>
                    <Button Content="⏹ Complete / Stop" Command="{Binding StopCommand}"/>
                    <Button Content="🚨 Trigger Fault" Command="{Binding TripAlarmCommand}" Style="{StaticResource DangerButton}"/>
                    <Button Content="🔄 Clear Alarm" Command="{Binding ClearAlarmCommand}" Style="{StaticResource WarningButton}"/>
                    <Button Content="🛠 Maintenance" Command="{Binding MaintenanceCommand}"/>
                    <Button Content="🛑 Power Off" Command="{Binding PowerOffCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- AUDIT LOG / EVENT TRAIL -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="STATE TRANSITION &amp; DOMAIN EVENT LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Real-time chronological events" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding AuditLogs}"
                         Background="#0B1120"
                         BorderBrush="#334155"
                         BorderThickness="1"
                         Foreground="#E2E8F0"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#1E293B"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- STATUS BAR FOOTER -->
        <Border Grid.Row="4" Background="#0B1120" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource PrimaryAccent}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Milestone 3: Domain &amp; State" FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>